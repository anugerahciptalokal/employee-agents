    "lucide-react": "^1.16.0",
    "marked": "^18.1.3",
    "nodemailer": "^10.6.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.7.3",
    "@types/node": "^20.17.19",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2"
  }
