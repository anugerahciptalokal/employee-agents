{
  "name": "employee-agents-backend",
  "version": "1.0.0",
  "description": "Open-source single-owner backend for Employee Agents",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
