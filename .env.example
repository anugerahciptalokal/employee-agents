# Employee Agents Production Deployment Environment

# Port mapped on the host machine (bound to 127.0.0.1)
APP_PORT=3060

# Host interface published by docker-compose.selfhosted.yml.
# Use 0.0.0.0 to expose the port on the LAN.
APP_HOST=127.0.0.1

# Optional public base URL advertised in the pairing QR when running behind
# a reverse proxy or tunnel, for example https://employee-agents.example.com
PUBLIC_URL=

# Optional master encryption key for the headless Linux vault.
# If left empty, Employee Agents will automatically generate and persist a secure 256-bit key in .data/.vault.key
OPEN_EMPLOYEE_VAULT_KEY=

# Optional API token for protecting remote access.
# If configured, requests outside loopback must send header `x-api-token: <your-token>`
OPEN_EMPLOYEE_API_TOKEN=

# Enable built-in headless Chromium + live browser WebSocket streaming (/api/browser-stream)
ENABLE_HEADLESS_BROWSER=1

# Comma-separated list of allowed Cross-Origin web frontend URLs (e.g. staging or production remote web)
# Example: CORS_ALLOWED_ORIGINS=https://employee-agents2.ruangapp.com,http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Optional default backend URL for remote web frontend builds (never hardcode in source)
VITE_DEFAULT_BACKEND_URL=

# Optional Enterprise Control Plane (Option 1) verification settings for linked backends
CONTROL_PLANE_PUBLIC_KEY=
CONTROL_PLANE_ISSUER=
CONTROL_PLANE_AUDIENCE=

# Enterprise Control Plane keys (recommended for production; falls back to .data/secrets/.enterprise-keys.json in dev)
# ENTERPRISE_MASTER_KEY=64-hex-characters-for-aes-256-gcm-and-hmac
# ENTERPRISE_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# ENTERPRISE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ENTERPRISE_MASTER_KEY=
ENTERPRISE_JWT_PRIVATE_KEY=
ENTERPRISE_JWT_PUBLIC_KEY=

# Enterprise SMTP Mailer for Workspace Invites (optional in dev; invite links are still returned in UI)
APP_MAIL_HOST=
APP_MAIL_PORT=587
APP_MAIL_USERNAME=
APP_MAIL_PASSWORD=
APP_MAIL_ENCRYPTION=
APP_MAIL_FROM_NAME="Employee Agents"

# Note: Cloudflare Tunnel routes directly through Docker network `global_tunnel`
# In Cloudflare Zero Trust Dashboard, set service URL to: http://open-employee:3060
# docker-compose.selfhosted.yml builds this branch and joins the same network.
# Create it once if missing: docker network create global_tunnel
