{
  "name": "@open-employee/contracts",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./dist/types.js",
  "types": "./dist/types.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.ts",
      "default": "./dist/contracts/*.js"
    }
  }
}
